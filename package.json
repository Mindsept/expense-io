{
  "name": "expense-io-version-b",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "ensure-bucket": "node scripts/ensure-bucket.mjs",
    "seed": "node scripts/seed.mjs",
    "test:unit": "vitest run",
    "test:api": "playwright test --config playwright.config.ts --project=api",
    "test:e2e": "playwright test --config playwright.config.ts --project=e2e",
    "test:smoke": "npm run test:e2e -- tests/e2e/mathis/MATH-01/roles.smoke.spec.ts",
    "test:collect": "node tests/support/check-collection.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit",
    "test:prepare": "node tests/support/test-stack.mjs prepare",
    "test:serve": "node tests/support/test-stack.mjs serve",
    "test:exec": "node tests/support/test-stack.mjs exec",
    "test:ci": "node tests/support/test-stack.mjs ci",
    "test:down": "node tests/support/test-stack.mjs down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
