# PostgreSQL (docker-compose)
DATABASE_URL=postgres://expense:expense@localhost:5433/expense_io

# Auth.js
# Required in every environment, including local development and production builds.
# After copying this file to .env, run: node scripts/generate-auth-secret.mjs
# The placeholder below is rejected; never use it as an actual secret.
AUTH_SECRET=changeme
# Requis uniquement en production (`next start`/`npm run start`).
# AUTH_TRUST_HOST=true

# Stockage objet S3-compatible (LocalStack en local, docker-compose)
S3_ENDPOINT=http://localhost:4567
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=receipts
S3_FORCE_PATH_STYLE=true

# Invitations — règle produit validée par Hugo le 26/10/2026 : 48 heures.
# Valeur explicite : le runtime conserve son refus sûr si la configuration manque.
ENROLLMENT_INVITATION_TTL_SECONDS=172800
# Fournir en privé l'origine canonique de l'application (HTTPS hors test isolé).
# AUTH_URL=https://app.example.com
# Fournir en privé l'URL HTTPS du bridge de livraison et son bearer dédié (>=32 caractères).
# Les lignes ci-dessous restent commentées : aucun fournisseur ni secret n'est préconfiguré.
# ENROLLMENT_DELIVERY_URL=https://mail-bridge.example.com/enrollment
# ENROLLMENT_DELIVERY_BEARER=
